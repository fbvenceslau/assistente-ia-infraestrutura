# Modelo de /home/hermes/.hermes/.env
# O comando `hermes gateway setup` cria e preenche boa parte deste arquivo.
# NUNCA publique o seu .env real.

# ---- Telegram -------------------------------------------------------------
# Token criado no @BotFather
TELEGRAM_BOT_TOKEN=
# IDs numéricos de quem pode falar com o assistente (separados por vírgula).
# Nunca deixe vazio.
TELEGRAM_ALLOWED_USERS=
# Chat que recebe avisos e resultados de tarefas agendadas (normalmente o seu ID)
TELEGRAM_HOME_CHANNEL=

# ---- Painel web (opcional) ------------------------------------------------
# Login do painel na porta 9119. Consulte a documentação do Hermes Agent
# para gerar o hash da senha e o segredo.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
